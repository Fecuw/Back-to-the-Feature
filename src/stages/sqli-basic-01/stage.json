      { "id": "gateway", "label": "EDGE-01", "role": "ゲートウェイ", "ip": "10.10.0.1", "status": "online", "services": ["nginx", "firewall"], "ports": [80, 443], "shell": true, "position": { "x": 35, "y": 46 } },
