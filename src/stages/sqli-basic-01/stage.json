    { "id": "valid-login", "settingId": "service_online", "label": "正しい認証情報でログイン成功", "target": "web", "entrypoint": "POST /api/login", "expect": true, "failureStatus": "MUMBLE" },
    { "id": "account-read", "settingId": "service_online", "label": "本人のアカウント情報を取得", "target": "db", "entrypoint": "SELECT own profile", "expect": true, "failureStatus": "CORRUPT" }
  ]
