  "defenses": [
    { "id": "parameterized_query", "serverId": "web", "label": "パラメータ化クエリ", "description": "認証SQLをプレースホルダー方式へ変更", "onLabel": "適用済み", "offLabel": "文字列連結", "default": false, "configPath": "/app/src/auth.ts" },
    { "id": "rate_limit", "serverId": "gateway", "label": "認証レート制限", "description": "同一IPからの試行を毎分5回に制限", "onLabel": "5 req/min", "offLabel": "制限なし", "default": false, "configPath": "/etc/nginx/conf.d/auth.conf" },
