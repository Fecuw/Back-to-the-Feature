{
  "name": "back-to-the-feature",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --workspace @btf/api",
    "dev:orchestrator": "npm run dev --workspace @btf/orchestrator",
    "infra:build": "docker compose --profile images build",
    "infra:up": "docker compose up -d postgres redis orchestrator api",
    "infra:down": "docker compose down",
    "validate": "node scripts/validate-stages.mjs",
    "build:services": "npm run build --workspace @btf/api && npm run build --workspace @btf/orchestrator",
    "build": "npm run validate && npm run build:services && tsc -b && vite build",
    "preview": "vite preview",
    "test:smoke": "node tests/smoke.mjs",
    "test:integration": "node tests/docker-integration.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
