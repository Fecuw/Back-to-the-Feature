# POSTGRES_DB: PostgreSQLに作成するゲーム用データベース名
POSTGRES_DB=btf
# POSTGRES_USER: PostgreSQLへ接続するゲーム用ユーザー名
POSTGRES_USER=btf
# POSTGRES_PASSWORD: PostgreSQLユーザーのパスワード（本番では必ず変更）
POSTGRES_PASSWORD=btf-local-password

# REDIS_PASSWORD: セッション所有権情報を保存するRedisのパスワード（本番では必ず変更）
REDIS_PASSWORD=redis-local-password
# JWT_SECRET: APIがアクセストークンへ署名する32文字以上の秘密値（本番では必ずランダム値へ変更）
JWT_SECRET=development-jwt-secret-must-be-changed
# ORCHESTRATOR_SHARED_SECRET: APIとDocker orchestrator間だけで共有する24文字以上の秘密値
ORCHESTRATOR_SHARED_SECRET=orchestrator-local-secret-change-me

# GOOGLE_CLIENT_ID: APIがGoogle IDトークンのaudience検証に使うWebクライアントID（未設定ならGoogleログイン無効）
GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID: ブラウザでGoogle Identity Servicesを初期化する同一のWebクライアントID
VITE_GOOGLE_CLIENT_ID=
# ALLOW_DEMO_AUTH: trueならローカルのデモ認証エンドポイントを許可（本番ではfalse）
ALLOW_DEMO_AUTH=true

# API_PORT: Dockerホストへ公開するAPIポート
API_PORT=18080
# VITE_API_URL: ブラウザが接続するAPIの公開URL
VITE_API_URL=http://127.0.0.1:18080
# DOCKER_GID: LinuxでDockerソケットへ接続できるホスト側グループID（Docker Desktopでは通常0）
DOCKER_GID=0
